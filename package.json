{
  "name": "comparador-supermercados",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comparador de precios de supermercados chilenos con motor de precio efectivo (membresias, cashback y escalas por cantidad)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe": "tsx src/cli/probe.ts",
    "comparar": "tsx src/cli/comparar.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fingerprint": "tsx src/cli/fingerprint.ts",
    "nextdata": "tsx src/cli/nextdata.ts",
    "inspeccionar": "tsx src/cli/inspeccionar.ts",
    "emparejar": "tsx src/cli/emparejar.ts",
    "catalogo": "tsx src/cli/catalogo.ts",
    "canasta": "tsx src/cli/canasta.ts",
    "nube": "tsx src/cli/nube.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
